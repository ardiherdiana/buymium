// This schema is shared with user backend - same database
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Role model
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  displayName String  @db.VarChar(255) @map("display_name")
  description String? @db.Text
  permissions String  @db.LongText
  createdAt   DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt   DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  users User[]

  @@index([name])
  @@map("roles")
}

// User model - shared with actual database
model User {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(255)
  email     String  @unique @db.VarChar(255)
  password  String  @db.VarChar(255)
  roleId    Int     @default(3) @map("role_id")
  googleId  String? @unique @db.VarChar(255) @map("google_id")
  avatar    String? @db.VarChar(500)
  createdAt DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  role      Role                  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  orders       Order[]
  channels     Channel[]
  posts        AutopostingPost[]
  schedules    AutopostingSchedule[]
  customers    Customer[]
  testimonials Testimonial[] @relation("TestimonialCreatedBy")
  upfollOrders UpfollOrder[]

  @@index([email])
  @@index([googleId])
  @@index([roleId])
  @@map("users")
}

// Product model - shared
model Product {
  id          Int     @id @default(autoincrement())
  title       String  @db.Text
  slug        String? @unique @db.VarChar(255)
  description String  @db.Text
  inStock     Int     @default(0) @map("in_stock")
  price       Float   @default(0)
  rating      Float   @default(0)
  isVerified  Boolean @default(false) @map("is_verified")
  sectionId   Int?    @map("section_id")
  imageUrl     String? @db.VarChar(500) @map("image_url")
  variantLabel String? @db.VarChar(100) @map("variant_label")
  sourceId    Int?    @unique @map("source_id")
  createdAt   DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt   DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  section      ProductSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  source       Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  orders       Order[]
  testimonials Testimonial[]
  variants     ProductVariant[]

  @@index([inStock])
  @@index([sectionId])
  @@map("products")
}

// Price tiers for a source-linked product, auto-detected from distinct Account
// targetFollowers values (e.g. 1000, 2000) within the linked Source; admin only fills in price.
model ProductVariant {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  name            String   @db.VarChar(100)
  price           Float
  targetFollowers Int?     @map("target_followers")
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductSection {
  id        Int      @id
  title     String
  subtitle  String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  products Product[]

  @@map("product_sections")
}

// Order model - shared
model Order {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  productId       Int       @map("product_id")
  quantity        Int
  totalPrice      Float     @map("total_price")
  status          String    @default("pending") @db.VarChar(50)
  groupId         String?   @db.VarChar(255) @map("group_id")
  paymentProof    String?   @db.VarChar(500) @map("payment_proof")
  proofUploadedAt DateTime? @db.DateTime(3) @map("proof_uploaded_at")
  confirmedAt     DateTime? @db.DateTime(3) @map("confirmed_at")
  adminNote       String?   @db.Text @map("admin_note")
  bankAccountId   Int?      @map("bank_account_id")
  inventoryRefs   String?   @db.Text @map("inventory_refs")
  createdAt       DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  reservedAccounts    Account[]
  sale                Sale?

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@index([groupId])
  @@index([bankAccountId])
  @@map("orders")
}

// Bank Account model - for manual bank transfer
model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   @db.VarChar(100) @map("bank_name")
  accountHolder String   @db.VarChar(255) @map("account_holder")
  accountNumber String   @db.VarChar(50) @map("account_number")
  logo          String?  @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt     DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive])
  @@map("bank_accounts")
}

// Autoposting Module Models
model Channel {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  username         String    @db.VarChar(255)
  type             String?   @db.VarChar(50)
  profilePhotoPath String?   @db.VarChar(500) @map("profile_photo_path")
  socialBuId       String?   @unique @db.VarChar(255) @map("social_bu_id")
  createdAt        DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt        DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     AutopostingPost[]
  schedules AutopostingSchedule[]

  @@index([userId])
  @@index([socialBuId])
  @@map("channels")
}

model AutopostingPost {
  id            Int        @id @default(autoincrement())
  userId        Int        @map("user_id")
  channelId     Int        @map("channel_id")
  caption       String     @db.Text
  source        String?    @db.VarChar(255)
  imageUrl      String?    @db.VarChar(500) @map("image_url")
  scheduledTime DateTime?  @map("scheduled_time") @db.DateTime(3)
  status        String     @default("drafted") @db.VarChar(50)
  socialBuId    String?    @unique @db.VarChar(255) @map("social_bu_id")
  postedAt      DateTime?  @map("posted_at") @db.DateTime(3)
  createdAt     DateTime   @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt     DateTime   @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channelId])
  @@index([status])
  @@index([scheduledTime])
  @@index([createdAt])
  @@map("posts")
}

model AutopostingSchedule {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  channelId Int     @map("channel_id")
  day       String  @db.VarChar(20)
  isActive  Boolean @default(true) @map("is_active")
  slots     String  @db.LongText
  createdAt DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([channelId])
  @@map("schedules")
}

// Management Module Models
model Account {
  id              Int       @id @default(autoincrement())
  orderIndex      Int?      @map("order_index")
  email           String?   @db.VarChar(255)
  passwordEmail   String?   @db.VarChar(255) @map("password_email")
  username        String?   @db.VarChar(255)
  password        String?   @db.VarChar(255)
  twoFactorAuth   String?   @db.VarChar(255) @map("two_factor_auth")
  year            String?   @db.VarChar(255)
  targetFollowers Int?      @map("target_followers")
  currentFollowers Int?     @map("current_followers")
  accountStatus   String?   @db.VarChar(50) @map("account_status")
  loginApp        String?   @db.VarChar(255) @map("login_app")
  capital         Float?
  phoneModel      String?   @db.VarChar(255) @map("phone_model")
  sourceSheetName String?   @db.VarChar(255) @map("source_sheet_name")
  sourceId        Int?      @map("source_id")
  isSold          Boolean   @default(false) @map("is_sold")
  reservedOrderId Int?      @map("reserved_order_id")
  createdAt       DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  source        Source?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  reservedOrder Order?      @relation(fields: [reservedOrderId], references: [id], onDelete: SetNull)
  saleLines     SaleLine[]

  @@index([email])
  @@index([username])
  @@index([isSold])
  @@index([sourceSheetName])
  @@index([sourceId])
  @@index([orderIndex])
  @@index([accountStatus])
  @@index([reservedOrderId])
  @@map("accounts")
}

model Source {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(255)
  spreadsheetId String   @db.VarChar(500) @map("spreadsheet_id")
  createdAt     DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt     DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  accounts Account[]
  sales    Sale[]
  product  Product?

  @@map("sources")
}

model JobSource {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(255)
  spreadsheetId String   @db.VarChar(500) @map("spreadsheet_id")
  createdAt     DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt     DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  accounts JobAccount[]

  @@map("job_sources")
}

model JobAccount {
  id               Int       @id @default(autoincrement())
  orderIndex       Int?      @map("order_index")
  jobSourceId      Int       @map("job_source_id")
  employeeName     String    @db.VarChar(255) @map("employee_name")
  email            String?   @db.VarChar(255)
  passwordEmail    String?   @db.VarChar(255) @map("password_email")
  username         String    @db.VarChar(255)
  password         String?   @db.VarChar(255)
  twoFactorAuth    String?   @db.VarChar(255) @map("two_factor_auth")
  year             String?   @db.VarChar(255)
  targetFollowers  Int?      @map("target_followers")
  hp               String?   @db.VarChar(255)
  aplikasi         String?   @db.VarChar(255)
  capital          Float?
  jobType          String    @db.VarChar(30) @map("job_type")
  loginStatus      String    @default("pending") @db.VarChar(20) @map("login_status")
  purchaseDate     DateTime? @db.Date @map("purchase_date")
  dueDate          DateTime? @db.Date @map("due_date")
  salaryPaid       Boolean   @default(false) @map("salary_paid")
  salaryProofUrl   String?   @db.VarChar(255) @map("salary_proof_url")
  salaryPaidAt     DateTime? @db.DateTime(3) @map("salary_paid_at")
  createdAt        DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt        DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  jobSource JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  @@unique([jobSourceId, username])
  @@index([employeeName])
  @@index([jobType])
  @@index([loginStatus])
  @@index([dueDate])
  @@index([orderIndex])
  @@index([salaryPaid])
  @@map("job_accounts")
}

model Customer {
  id              Int       @id @default(autoincrement())
  usernameSh      String?   @unique @db.VarChar(255) @map("username_shopee")
  nomorHp         String?   @db.VarChar(20) @map("nomor_hp")
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  creator   User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sales     Sale[]
  upfollOrders UpfollOrder[]

  @@index([createdAt])
  @@map("customers")
}

// Upfoll Module Models
// Organic IG follow-for-tag giveaway sponsorship — not panel/inject followers.
// Vendors are the suppliers who run the actual giveaway; each vendor defines
// its own tiers (target-follower package + price it charges, e.g. "1K
// Followers" = Rp15.000) since different vendors' giveaways draw from
// different follower pools — there's no shared tier catalog. UpfollItem
// records one sponsored username against a specific vendor's tier, and a
// unique constraint on (username, vendorTierId) blocks re-tagging the same
// vendor's giveaway audience twice; the same username is free to be reused
// under a different vendor.
model UpfollVendor {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  tiers UpfollVendorTier[]

  @@index([isActive])
  @@map("upfoll_vendors")
}

model UpfollVendorTier {
  id              Int      @id @default(autoincrement())
  vendorId        Int      @map("vendor_id")
  name            String   @db.VarChar(100)
  targetFollowers Int      @map("target_followers")
  price           Float
  createdAt       DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  vendor UpfollVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items  UpfollItem[]

  @@index([vendorId])
  @@map("upfoll_vendor_tiers")
}

// saleId mirrors this order into the shared Sale/SaleLine tables at creation
// time so it's automatically picked up by the existing Finance > Sales and
// Analytics pages without those pages needing to know about Upfoll at all.
model UpfollOrder {
  id                Int      @id @default(autoincrement())
  orderNumber       String   @db.VarChar(255) @map("order_number")
  customerId        Int?     @map("customer_id")
  totalSalePrice    Float    @map("total_sale_price")
  totalProfit       Float    @default(0) @map("total_profit")
  isShopee          Boolean  @default(false) @map("is_shopee")
  shopeeOrderNumber String?  @db.VarChar(255) @map("shopee_order_number")
  saleId            Int?     @unique @map("sale_id")
  createdBy         Int?     @map("created_by")
  createdAt         DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt         DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator  User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sale     Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    UpfollItem[]

  @@index([customerId])
  @@index([isShopee])
  @@index([createdAt])
  @@map("upfoll_orders")
}

model UpfollItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  vendorTierId     Int      @map("vendor_tier_id")
  username         String   @db.VarChar(255)
  startingFollowers Int?    @map("starting_followers")
  currentFollowers Int?     @map("current_followers")
  capital          Float    @default(0)
  unitSalePrice    Float    @map("unit_sale_price")
  profit           Float    @default(0)
  status           String   @default("progress") @db.VarChar(20)
  createdAt        DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt        DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  order      UpfollOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorTier UpfollVendorTier @relation(fields: [vendorTierId], references: [id], onDelete: Restrict)

  @@unique([username, vendorTierId])
  @@index([orderId])
  @@index([vendorTierId])
  @@index([status])
  @@map("upfoll_items")
}

model Sale {
  id              Int       @id @default(autoincrement())
  salesNumber     String    @db.VarChar(255) @map("sales_number")
  customerId      Int?      @map("customer_id")
  totalSalePrice  Float     @map("total_sale_price")
  totalProfit     Float     @map("total_profit")
  isShopee        Boolean   @default(false) @map("is_shopee")
  shopeeNumber    String?   @db.VarChar(255) @map("shopee_number")
  sourceId        Int?      @map("source_id")
  orderId         Int?      @unique @map("order_id")
  createdAt       DateTime  @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt       DateTime  @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  source   Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  saleLines SaleLine[]
  upfollOrder UpfollOrder?

  @@index([customerId])
  @@index([sourceId])
  @@index([createdAt])
  @@index([isShopee])
  @@map("sales")
}

model SaleLine {
  id              Int       @id @default(autoincrement())
  saleId          Int       @map("sale_id")
  accountId       Int?      @map("account_id")
  unitSalePrice   Float?    @map("unit_sale_price")
  price           Float     @default(0)
  profit          Float     @default(0)
  createdAt       DateTime  @db.DateTime(3) @default(now()) @map("created_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([accountId])
  @@map("sale_lines")
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  createdById  Int      @map("created_by_id")
  orderId      Int?     @unique @map("order_id")
  customerName String   @db.VarChar(255) @map("customer_name")
  message      String   @db.Text
  rating       Int      @default(5)
  avatar       String?  @db.VarChar(500)
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt    DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPublished])
  @@map("testimonials")
}
