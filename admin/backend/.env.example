# Server
PORT=5001
NODE_ENV=development

# Database (same MySQL server as user/backend)
DATABASE_URL="mysql://user:password@localhost:3306/buymium"

# Auth (must match user/backend)
JWT_SECRET=          # minimum 32 characters
ENCRYPTION_KEY=      # 64-character hex string (AES-256-GCM key)

# Frontend
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:3000

# Email (shared with user/backend)
RESEND_API_KEY=
EMAIL_FROM=

# Google Sheets sync — each Source (see /management/sources) has its own spreadsheet ID,
# configured in the database, not here.
GOOGLE_TRANSLATE_API_KEY=
# Service account JSON must also be placed in admin/backend/credentials/

# AI captions (autoposting)
OPENAI_API_KEY=

# Social auto-posting
SOCIALBU_ACCESS_TOKEN=

# Follower scanning
RAPID_API_KEY=

DEBUG=
