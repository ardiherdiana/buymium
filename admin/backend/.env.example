# Admin Backend Environment Example

# Database (Shared with User Backend)
DATABASE_URL="mysql://root:@localhost:3306/buymium"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_chars_here

# Stock Credential Encryption (AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Admin Panel Info
ADMIN_PANEL_NAME=Buymium Admin
ADMIN_PANEL_VERSION=1.0.0

# === Email Notification (Resend) ===
# Pakai API key SAMA dengan user backend (1 akun Resend dipakai 2 backend)
RESEND_API_KEY=
EMAIL_FROM=Buymium <noreply@buymium.id>

# === Customer-facing site URL (untuk link di dalam email customer) ===
# WAJIB domain customer (buymium.id), BUKAN domain admin (testing.buymium.store)
SITE_URL=https://buymium.id
