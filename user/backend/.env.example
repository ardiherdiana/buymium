DATABASE_URL="mysql://root:your_db_password@localhost:3306/buymium"
JWT_SECRET=your_jwt_secret_key_min_32_chars_here
# Stock Credential Encryption (AES-256-GCM) - must match admin/backend
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
PORT=5000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# === Email Notification (Resend) ===
# Daftar di https://resend.com (free 100 email/hari)
# Domain `buymium.id` harus verified dulu di dashboard Resend
RESEND_API_KEY=
EMAIL_FROM=Buymium <noreply@buymium.id>

# === Public site URL (untuk link email + sitemap.xml) ===
SITE_URL=https://buymium.id
