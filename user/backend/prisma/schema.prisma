generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  displayName String   @db.VarChar(255) @map("display_name")
  description String?  @db.Text
  permissions String   @db.LongText
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  users       User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  password     String   @db.VarChar(255)
  roleId       Int      @default(3) @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id])
  googleId     String?  @unique @db.VarChar(255) @map("google_id")
  avatar       String?  @db.VarChar(500)
  orders       Order[]
  testimonials Testimonial[] @relation("TestimonialCreatedBy")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id           Int             @id @default(autoincrement())
  orders       Order[]
  testimonials Testimonial[]
  title        String          @db.Text
  slug         String?         @unique @db.VarChar(255)
  description  String          @db.Text
  inStock      Int             @default(0) @map("in_stock")
  price        Float           @default(0)
  rating       Float           @default(0)
  isVerified   Boolean         @default(false) @map("is_verified")
  imageUrl     String?         @db.VarChar(500) @map("image_url")
  sourceId     Int?            @unique @map("source_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("products")
}

// Minimal projection of the admin-managed price tiers, used only to restrict which
// Account/Accsmarket rows count as sellable stock for a source-linked product (see
// Product.sourceId) - a product with variants only sells the follower tiers it kept.
model ProductVariant {
  id              Int     @id @default(autoincrement())
  productId       Int     @map("product_id")
  name            String  @db.VarChar(100)
  price           Float
  targetFollowers Int?    @map("target_followers")
  isActive        Boolean @default(true) @map("is_active")

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  productId      Int          @map("product_id")
  quantity       Int          @default(1)
  totalPrice     Float        @map("total_price")
  status         String       @default("pending") @db.VarChar(50)
  groupId        String?      @db.VarChar(255) @map("group_id")
  paymentProof   String?      @db.VarChar(500) @map("payment_proof")
  proofUploadedAt DateTime?   @map("proof_uploaded_at")
  confirmedAt    DateTime?    @map("confirmed_at")
  adminNote      String?      @db.Text @map("admin_note")
  bankAccountId  Int?         @map("bank_account_id")
  inventoryRefs  String?      @db.Text @map("inventory_refs")
  user           User         @relation(fields: [userId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([groupId])
  @@map("orders")
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   @db.VarChar(100) @map("bank_name")
  accountHolder String   @db.VarChar(255) @map("account_holder")
  accountNumber String   @db.VarChar(50) @map("account_number")
  logo          String?  @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  orders        Order[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

// Minimal projections of the admin-only inventory tables (accounts/accsmarkets), used
// only to reserve/read/deliver stock for Product rows with a sourceId (see Product.sourceId).
model Account {
  id              Int      @id @default(autoincrement())
  email           String?  @db.VarChar(255)
  username        String?  @db.VarChar(255)
  password        String?  @db.VarChar(255)
  accountStatus   String?  @db.VarChar(50) @map("account_status")
  targetFollowers Int?     @map("target_followers")
  sourceId        Int?     @map("source_id")
  isSold          Boolean  @default(false) @map("is_sold")
  reservedOrderId Int?     @map("reserved_order_id")

  @@index([sourceId])
  @@index([isSold])
  @@index([reservedOrderId])
  @@map("accounts")
}

model Accsmarket {
  id              Int      @id @default(autoincrement())
  email           String?  @db.VarChar(255)
  passwordEmail   String?  @db.VarChar(255) @map("password_email")
  username        String?  @db.VarChar(255)
  password        String?  @db.VarChar(255)
  twoFactorAuth   String?  @db.VarChar(255) @map("two_factor_auth")
  accountStatus   String?  @db.VarChar(50) @map("account_status")
  targetFollowers Int?     @map("target_followers")
  sourceId        Int?     @map("source_id")
  isSold          Boolean  @default(false) @map("is_sold")
  reservedOrderId Int?     @map("reserved_order_id")
  year            String?  @db.VarChar(255)

  @@index([sourceId])
  @@index([isSold])
  @@index([reservedOrderId])
  @@map("accsmarkets")
}

model Source {
  id           Int     @id @default(autoincrement())
  isAccsmarket Boolean @default(false) @map("is_accsmarket")

  @@map("sources")
}

model Channel {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  username         String   @db.VarChar(255)
  type             String?  @db.VarChar(50)
  profilePhotoPath String?  @db.VarChar(500) @map("profile_photo_path")
  socialBuId       String?  @unique @db.VarChar(255) @map("social_bu_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([socialBuId])
  @@map("channels")
}

model AccountAccessLog {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  userId    Int      @map("user_id")
  ip        String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([userId])
  @@map("account_access_logs")
}

model OtpToken {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  purpose   String   @db.VarChar(30) @map("purpose")
  codeHash  String   @db.VarChar(255) @map("code_hash")
  payload   String?  @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("otp_tokens")
}

model Testimonial {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  createdById  Int      @map("created_by_id")
  orderId      Int?     @unique @map("order_id")
  customerName String   @db.VarChar(255) @map("customer_name")
  message      String   @db.Text
  rating       Int      @default(5)
  avatar       String?  @db.VarChar(500)
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @db.DateTime(3) @default(now()) @map("created_at")
  updatedAt    DateTime @db.DateTime(3) @default(now()) @updatedAt @map("updated_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPublished])
  @@map("testimonials")
}
