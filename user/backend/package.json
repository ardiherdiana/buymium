{
  "name": "buymium-backend",
  "version": "1.0.0",
  "description": "Buymium ecommerce backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:seed": "tsx prisma/seed.ts",
